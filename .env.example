# =====================================================================
#  Site de fotografia — variáveis de ambiente
#  Copie para .env e preencha. NUNCA versione o .env.
#  Variáveis sem prefixo NEXT_PUBLIC_ ficam somente no servidor.
# =====================================================================

# --- Obrigatórias ---------------------------------------------------
# PostgreSQL (local, Supabase, Neon…). No Supabase, use a "connection string" do pooler
# em modo sessão (porta 5432). Em modo transação (porta 6543), defina DATABASE_PREPARE=false.
DATABASE_URL=postgres://usuario:senha@localhost:5432/fotografia
# DATABASE_PREPARE=false
# DATABASE_POOL_MAX=10

# URL pública do site (sem barra no final) — usada em e-mails, links e SEO
APP_URL=http://localhost:3000

# Segredo com 32+ caracteres aleatórios (assina URLs temporárias, cookies de galeria e tokens).
# Gere com: openssl rand -base64 48
APP_SECRET=

# --- Conta administrativa inicial (usada pelo npm run db:seed) -------
ADMIN_EMAIL=clickjuu@gmail.com
# Se vazio, o seed gera uma senha aleatória e mostra uma única vez no terminal
ADMIN_PASSWORD=

# --- Armazenamento de arquivos ---------------------------------------
# local = disco do servidor (VPS/Docker com volume persistente)
# s3    = Supabase Storage (S3), Cloudflare R2, AWS S3, Backblaze B2…
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3_ENDPOINT=https://<projeto>.supabase.co/storage/v1/s3
# S3_REGION=us-east-1
# S3_BUCKET=fotografias
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# Opcional: domínio de CDN na frente do bucket (mantém as URLs assinadas)
# S3_PUBLIC_URL=https://cdn.seudominio.com.br
UPLOAD_MAX_MB=40

# --- E-mail transacional (opcional, recomendado) ---------------------
# Sem configuração, os e-mails NÃO são enviados (o painel mostra isso claramente).
EMAIL_FROM="Clickju <contato@seudominio.com.br>"
RESEND_API_KEY=
# ou SMTP: smtps://usuario:senha@smtp.seudominio.com.br:465
SMTP_URL=
# Destinatário das notificações (padrão: e-mail de contato das Configurações)
NOTIFY_EMAIL=clickjuu@gmail.com

# --- Inteligência artificial (opcional) ------------------------------
# Claude: assistente virtual, legendas/etiquetas e sequência narrativa
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Voyage AI: busca semântica por imagem (embeddings multimodais)
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-multimodal-3
# Replicate: aprimoramento de resolução e remoção de fundo
# Formato "dono/modelo" (modelos oficiais) ou "dono/modelo:versão"
REPLICATE_API_TOKEN=
REPLICATE_UPSCALE_MODEL=
REPLICATE_BACKGROUND_MODEL=

# --- Anti-robô extra (opcional) --------------------------------------
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Retenção ---------------------------------------------------------
AUDIT_RETENTION_MONTHS=24
